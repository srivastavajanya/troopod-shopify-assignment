{% comment %}
  Purelane Customer Reviews Rail Section
  Infinite horizontal marquee with touch pause handlers & merchant-editable review blocks
{% endcomment %}

<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">★★★★★</span> <b>{{ section.settings.rating_score | default: '4.8' }}</b> {{ section.settings.rating_text | default: 'from 8,000+ reviews' }}</span>
      <span class="agg">{{ section.settings.social_proof_prefix | default: 'Loved by' }} <b>{{ section.settings.social_proof_count | default: '12 lakh+' }}</b> {{ section.settings.social_proof_suffix | default: 'homes' }}</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">
            {% case block.settings.star_rating %}
              {% when 1 %}★☆☆☆☆
              {% when 2 %}★★☆☆☆
              {% when 3 %}★★★☆☆
              {% when 4 %}★★★★☆
              {% else %}★★★★★
            {% endcase %}
          </div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.body }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            <span>· {{ block.settings.product_tag }}</span>
          </div>
        </article>
      {% endfor %}
      {% comment %} Duplicate blocks to guarantee continuous infinite marquee loop {% endcomment %}
      {% for block in section.blocks %}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">
            {% case block.settings.star_rating %}
              {% when 1 %}★☆☆☆☆
              {% when 2 %}★★☆☆☆
              {% when 3 %}★★★☆☆
              {% when 4 %}★★★★☆
              {% else %}★★★★★
            {% endcase %}
          </div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.body }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            <span>· {{ block.settings.product_tag }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof_prefix",
      "label": "Social Proof Prefix",
      "default": "Loved by"
    },
    {
      "type": "text",
      "id": "social_proof_count",
      "label": "Social Proof Count",
      "default": "12 lakh+"
    },
    {
      "type": "text",
      "id": "social_proof_suffix",
      "label": "Social Proof Suffix",
      "default": "homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review Card",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Quote",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Purchased Product Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_tag": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_tag": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_tag": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_tag": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_tag": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
