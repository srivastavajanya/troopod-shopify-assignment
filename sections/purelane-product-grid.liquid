{% comment %}
  Purelane Product Grid Section - Bestsellers Catalog
  Binds to Shopify collections or falls back to standard blocks
{% endcomment %}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {% assign selected_collection = collections[section.settings.collection] %}
      {% if selected_collection and selected_collection.products.size > 0 %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          {% render 'purelane-product-card', product: product %}
        {% endfor %}
      {% else %}
        {% comment %} Fallback Product Cards when no collection selected {% endcomment %}
        {% render 'purelane-product-card', title: 'Tap cleaner & limescale remover', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Best seller', rating: '4.8', reviews_count: '237', fallback_class: 'p-tap' %}
        {% render 'purelane-product-card', title: 'Kitchen cleaner, foaming', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Best seller', rating: '4.8', reviews_count: '254', fallback_class: 'p-kitchen' %}
        {% render 'purelane-product-card', title: 'Copper, bronze & brass cleaner', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Top rated', rating: '4.8', reviews_count: '231', fallback_class: 'p-metal' %}
        {% render 'purelane-product-card', title: 'Washing machine cleaner & descaler', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'New', rating: '4.8', reviews_count: '183', fallback_class: 'p-wm' %}
        {% render 'purelane-product-card', title: 'Natural herbal floor cleaner', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Best seller', rating: '4.9', reviews_count: '312', fallback_class: 'p-floor' %}
        {% render 'purelane-product-card', title: 'Organic dishwash liquid gel', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Eco choice', rating: '4.8', reviews_count: '198', fallback_class: 'p-dish' %}
        {% render 'purelane-product-card', title: 'Non-toxic toilet cleaner', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Top rated', rating: '4.7', reviews_count: '165', fallback_class: 'p-toilet' %}
        {% render 'purelane-product-card', title: 'Gentle hydrating liquid handwash', price: '₹200', compare_price: '₹299', discount_tag: '33% off', pill_text: 'Gentle', rating: '4.9', reviews_count: '289', fallback_class: 'p-handwash' %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}
